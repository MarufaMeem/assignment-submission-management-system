# Copy this file to backend/AssignmentSystem.Api/.env and fill in real values.
# .env is gitignored - never commit real secrets.

# PostgreSQL connection string
# Format matches Npgsql's expected keys.
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=assignment_system;Username=postgres;Password=123456

# JWT signing secret - use a long, random string in any real environment.
# This one is for LOCAL DEVELOPMENT ONLY.
Jwt__Secret=dev-only-super-secret-key-change-me-please-32chars-min
Jwt__Issuer=AssignmentSystem.Api
Jwt__Audience=AssignmentSystem.Client
Jwt__ExpiryMinutes=60

# Comma-separated list of frontend origins allowed by CORS (see Program.cs).
# The double underscore in keys above is ASP.NET Core's convention for mapping
# a flat environment variable name to a nested configuration section
# (e.g. ConnectionStrings__DefaultConnection -> ConnectionStrings:DefaultConnection).
Cors__AllowedOrigins__0=http://localhost:3000
